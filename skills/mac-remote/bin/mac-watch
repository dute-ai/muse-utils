#!/bin/bash
# mac-watch — supervise tmux sessions on the Mac, report status changes.
#
# Polls each watched session's pane and classifies it:
#   WORKING      output changed since last check
#   IDLE         no new output for a while (often: a step finished)
#   NEEDS_INPUT  an input/confirmation prompt is visible
#   STALLED      quiet longer than MAC_WATCH_STALL_MIN (default 30)
#   GONE         the tmux session no longer exists
#
# Prints only transitions since the last check — quiet runs print one line.
# Detection is heuristic; treat NEEDS_INPUT/IDLE as "look here", not proof.
# Meant to run on a schedule (e.g. every 5 minutes); the caller decides
# whether the output is worth surfacing to the user.
#
# Usage:
#   mac-watch add <name>    watch a session
#   mac-watch rm <name>     stop watching a session
#   mac-watch list          watched sessions + last known status
#   mac-watch check         poll all watched sessions, print transitions
set -euo pipefail
BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
MAC_SSH="$BIN_DIR/mac-ssh"
MAC_TMUX="$BIN_DIR/mac-tmux"
STALL_MIN="${MAC_WATCH_STALL_MIN:-30}"
LINES=50

# --- state dir (same resolution as mac-ssh) ---
if [ -n "${MAC_REMOTE_STATE_DIR:-}" ]; then
  STATE_DIR="$MAC_REMOTE_STATE_DIR"
else
  REPO_ROOT="$(cd "$BIN_DIR/../../.." 2>/dev/null && pwd || true)"
  if [ -n "${REPO_ROOT:-}" ] && [ -d "$REPO_ROOT/state" ]; then
    STATE_DIR="$REPO_ROOT/state"
  else
    STATE_DIR="$HOME/workspace/mac-remote/state"
  fi
fi
WATCH_DIR="$STATE_DIR/watch"
WATCHLIST="$WATCH_DIR/watchlist"
mkdir -p "$WATCH_DIR"
[ -f "$WATCHLIST" ] || : > "$WATCHLIST"

# Case-insensitive prompt patterns that mean "the agent is waiting on you".
NEEDS_INPUT_RE='do you want to proceed|\(y(es)?/n(o)?\)|press enter to (confirm|continue|approve|proceed)|waiting for (your |user )?input|would you like me to continue|approval required|needs your approval|confirm (to )?(continue|proceed)|❯ 1\.'

now="$(date +%s)"

load_state() { # $1=name -> S_HASH S_STATUS S_UNCHANGED S_LASTCHANGE S_NOTIFIED
  S_HASH=""; S_STATUS=""; S_UNCHANGED=0; S_LASTCHANGE="$now"; S_NOTIFIED=""
  local f="$WATCH_DIR/$1.state"
  if [ -f "$f" ]; then set -a; . "$f"; set +a; fi
  S_HASH="${HASH:-}"; S_STATUS="${STATUS:-}"; S_UNCHANGED="${UNCHANGED:-0}"
  S_LASTCHANGE="${LASTCHANGE:-$now}"; S_NOTIFIED="${NOTIFIED:-}"
}

save_state() { # $1=name $2=hash $3=status $4=unchanged $5=lastchange $6=notified
  printf 'HASH=%s\nSTATUS=%s\nUNCHANGED=%s\nLASTCHANGE=%s\nNOTIFIED=%s\n' \
    "$2" "$3" "$4" "$5" "$6" > "$WATCH_DIR/$1.state"
}

excerpt() { # last 12 non-empty lines of stdin
  grep -v '^[[:space:]]*$' | tail -12
}

check_one() { # $1=name ; prints a transition block only on status change
  local name="$1" capture="" hash="" status detail unchanged lastchange notified quiet_min
  load_state "$name"
  unchanged="$S_UNCHANGED"; lastchange="$S_LASTCHANGE"; notified="$S_NOTIFIED"

  if ! capture="$("$MAC_TMUX" see "$name" "$LINES" 2>&1)"; then
    status="GONE"; detail="session not found"
  elif [ -z "${capture//[[:space:]]/}" ]; then
    status="UNKNOWN"; detail="empty pane"
  else
    hash="$(printf '%s' "$capture" | sha1sum | cut -d' ' -f1)"
    if [ -n "$S_HASH" ] && [ "$hash" = "$S_HASH" ]; then
      unchanged=$((unchanged + 1))
    else
      unchanged=0; lastchange="$now"
    fi
    quiet_min=$(( (now - lastchange) / 60 ))
    if printf '%s' "$capture" | grep -qiE "$NEEDS_INPUT_RE"; then
      status="NEEDS_INPUT"; detail="input prompt visible"
    elif [ "$unchanged" -gt 0 ] && [ "$quiet_min" -ge "$STALL_MIN" ]; then
      status="STALLED"; detail="no output for ${quiet_min}m"
    elif [ "$unchanged" -gt 0 ]; then
      status="IDLE"; detail="quiet for ${quiet_min}m"
    else
      status="WORKING"; detail="new output"
    fi
  fi

  if [ "$status" != "$notified" ]; then
    printf -- '-> %s: %s (%s)\n' "$name" "$status" "$detail"
    case "$status" in
      NEEDS_INPUT|STALLED|GONE)
        printf '%s' "$capture" | excerpt | sed 's/^/   | /'
        ;;
    esac
    notified="$status"
  fi
  save_state "$name" "$hash" "$status" "$unchanged" "$lastchange" "$notified"
}

cmd_add() {
  local name="${1:?"add <name>"}"
  if [ -f "$WATCHLIST" ] && grep -qx "$name" "$WATCHLIST"; then
    echo "$name is already watched"; return 0
  fi
  if ! "$MAC_TMUX" list 2>/dev/null | grep -q "^${name}:"; then
    echo "warning: no tmux session '$name' right now (watching anyway)"
  fi
  printf '%s\n' "$name" >> "$WATCHLIST"
  echo "watching $name"
}

cmd_rm() {
  local name="${1:?"rm <name>"}"
  grep -vx "$name" "$WATCHLIST" > "$WATCHLIST.tmp" || true
  mv "$WATCHLIST.tmp" "$WATCHLIST"
  rm -f "$WATCH_DIR/$name.state"
  echo "stopped watching $name"
}

cmd_list() {
  local name quiet_min
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    load_state "$name"
    if [ -z "$S_STATUS" ]; then
      echo "$name: never checked"
    else
      quiet_min=$(( (now - S_LASTCHANGE) / 60 ))
      echo "$name: $S_STATUS (last change ~${quiet_min}m ago)"
    fi
  done < "$WATCHLIST"
}

cmd_check() {
  local names output changed total
  names="$(grep -v '^[[:space:]]*$' "$WATCHLIST" || true)"
  if [ -z "$names" ]; then
    echo "watch: no sessions watched (mac-watch add <name>)"; return 0
  fi
  if ! "$MAC_SSH" 'true' >/dev/null 2>&1; then
    echo "watch: transport failed — Mac unreachable? (states unchanged)"; return 1
  fi
  total="$(printf '%s\n' "$names" | grep -c .)"
  output=""
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    output="${output}$(check_one "$name")"$'\n'
  done <<< "$names"
  changed="$(printf '%s' "$output" | grep -c '^-> ' || true)"
  printf 'watch %s: %s watched\n' "$(date '+%F %T %Z')" "$total"
  if [ "$changed" -eq 0 ]; then
    echo "all quiet"
  else
    printf '%s' "$output" | grep '^-> \|^   | '
  fi
}

cmd="${1:?"usage: mac-watch add|rm|list|check ..."}"; shift
case "$cmd" in
  add)   cmd_add "$@" ;;
  rm)    cmd_rm "$@" ;;
  list)  cmd_list ;;
  check) cmd_check ;;
  *) echo "unknown command: $cmd" >&2; exit 1 ;;
esac
