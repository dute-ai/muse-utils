#!/usr/bin/env python3
"""mac-watch — supervise tmux sessions on the Mac.

A mechanical reporter, not a judge. For each watched session it captures the
pane, diffs against the last check, and reports what changed. It never decides
"needs input" or "stuck" — that call belongs to the operator reading this
output (an LLM on a scheduled run, or a human).

Statuses:
  CHANGED   pane content changed since last check (new lines shown)
  QUIET     unchanged; reports how long it's been quiet
  GONE      the tmux session no longer exists

Every distinct pane state is shown once; repeat checks print one line per
session, so scheduled runs are trivially triageable.

Usage:
  mac-watch add <name>    watch a session
  mac-watch rm <name>     stop watching a session
  mac-watch list          watched sessions + last known state
  mac-watch check [--json]
"""
import datetime
import hashlib
import json
import os
import subprocess
import sys

BIN_DIR = os.path.dirname(os.path.abspath(__file__))
MAC_SSH = os.path.join(BIN_DIR, "mac-ssh")
MAC_TMUX = os.path.join(BIN_DIR, "mac-tmux")
CAPTURE_LINES = 60   # pane lines captured per check
TAIL_LINES = 12      # lines shown for a newly-seen quiet state
NEW_LINES_CAP = 30   # cap on "new lines" shown for a changed pane


def state_dir():
    if os.environ.get("MAC_REMOTE_STATE_DIR"):
        return os.environ["MAC_REMOTE_STATE_DIR"]
    repo_root = os.path.abspath(os.path.join(BIN_DIR, "..", "..", ".."))
    if os.path.isdir(os.path.join(repo_root, "state")):
        return os.path.join(repo_root, "state")
    return os.path.expanduser("~/workspace/mac-remote/state")


WATCH_DIR = os.path.join(state_dir(), "watch")
WATCHLIST = os.path.join(WATCH_DIR, "watchlist")
os.makedirs(WATCH_DIR, exist_ok=True)
if not os.path.exists(WATCHLIST):
    open(WATCHLIST, "w").close()


def run(*args):
    return subprocess.run(args, capture_output=True, text=True)


def load_watchlist():
    with open(WATCHLIST) as f:
        return [line.strip() for line in f if line.strip()]


def save_watchlist(names):
    with open(WATCHLIST, "w") as f:
        f.write("".join(n + "\n" for n in names))


def state_path(name):
    # Map pane addressing into filename-safe form: demo:0.1 -> demo_0.1,
    # %3 -> PCT3. Session names can't contain ':' so this can't collide.
    safe = name.replace("%", "PCT").replace(":", "_")
    safe = "".join(c for c in safe if c.isalnum() or c in "-_.")
    return os.path.join(WATCH_DIR, safe + ".json")


def load_state(name):
    try:
        with open(state_path(name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(name, st):
    with open(state_path(name), "w") as f:
        json.dump(st, f)


def trim_block(lines):
    """Drop leading blank lines from a block about to be shown."""
    i = 0
    while i < len(lines) and not lines[i].strip():
        i += 1
    return lines[i:]


def check_one(name, now):
    """Poll one session. Returns a dict: name/status/detail/block."""
    st = load_state(name)
    r = run(MAC_TMUX, "see", name, str(CAPTURE_LINES))

    if r.returncode != 0:
        # Session is gone. Report the error once, then one-liners.
        block = None
        if not st.get("gone_shown"):
            err = (r.stdout or r.stderr).strip() or "(no output)"
            block = [err]
            st["gone_shown"] = True
        st["gone"] = True
        st["status"] = "GONE"
        save_state(name, st)
        return {"name": name, "status": "GONE", "detail": "session not found",
                "block": block}

    lines = [ln.rstrip() for ln in r.stdout.splitlines()]
    while lines and not lines[-1].strip():
        lines.pop()
    digest = hashlib.sha1("\n".join(lines).encode()).hexdigest()
    prev_digest = st.get("hash")
    prev_lines = st.get("lines", [])

    if digest != prev_digest:
        prev_set = set(prev_lines)
        new_lines = [ln for ln in lines if ln not in prev_set]
        if not prev_lines:
            detail, block = "first check", trim_block(lines[-20:])
        else:
            detail = f"{len(new_lines)} new line(s)"
            block = trim_block(new_lines[:NEW_LINES_CAP] or lines[-TAIL_LINES:])
        st.update(hash=digest, last_change=now, lines=lines[-CAPTURE_LINES:],
                  shown_hash=digest, gone=False, gone_shown=False,
                  status="CHANGED")
        save_state(name, st)
        return {"name": name, "status": "CHANGED", "detail": detail,
                "block": block}

    quiet_min = int((now - st.get("last_change", now)) // 60)
    detail = f"quiet {quiet_min}m"
    st["status"] = "QUIET"
    block = None
    if st.get("shown_hash") != digest:
        # Unchanged since last check, but the judge hasn't seen this state.
        block = trim_block(lines[-TAIL_LINES:])
        st["shown_hash"] = digest
    save_state(name, st)
    return {"name": name, "status": "QUIET", "detail": detail, "block": block}


def target_exists(name):
    if name.startswith("%") or ":" in name:
        return run(MAC_TMUX, "panes", name).returncode == 0
    r = run(MAC_TMUX, "list")
    return r.returncode == 0 and f"\n{name}:" in "\n" + r.stdout


def cmd_add(name):
    names = load_watchlist()
    if name in names:
        print(f"{name} is already watched")
        return 0
    if not target_exists(name):
        print(f"warning: no such session/pane '{name}' right now (watching anyway)")
    names.append(name)
    save_watchlist(names)
    print(f"watching {name}")
    return 0


def cmd_rm(name):
    names = [n for n in load_watchlist() if n != name]
    save_watchlist(names)
    try:
        os.remove(state_path(name))
    except OSError:
        pass
    print(f"stopped watching {name}")
    return 0


def cmd_list():
    names = load_watchlist()
    now = datetime.datetime.now().timestamp()
    for name in names:
        st = load_state(name)
        status = st.get("status")
        if not status:
            print(f"{name}: never checked")
        elif status == "GONE":
            print(f"{name}: GONE")
        else:
            quiet_min = int((now - st.get("last_change", now)) // 60)
            print(f"{name}: {status} (last change ~{quiet_min}m ago)")
    return 0


def cmd_check(as_json):
    names = load_watchlist()
    if not names:
        print("watch: no sessions watched (mac-watch add <name>)")
        return 0
    if run(MAC_SSH, "true").returncode != 0:
        print("watch: transport failed — Mac unreachable? (state unchanged)")
        return 1
    now = datetime.datetime.now().timestamp()
    results = [check_one(n, now) for n in names]
    if as_json:
        print(json.dumps({"sessions": results}, indent=2))
        return 0
    ts = datetime.datetime.now().strftime("%F %T %Z")
    print(f"watch {ts} — {len(names)} session(s)")
    news = False
    for res in results:
        line = f"### {res['name']} — {res['status']}"
        if res.get("detail"):
            line += f" ({res['detail']})"
        print(line)
        if res.get("block"):
            news = True
            for ln in res["block"]:
                print(f"    {ln}")
    if not news:
        print("all quiet")
    return 0


def usage():
    print(__doc__.strip().split("\n\n")[-1])
    return 1


def main(argv):
    if len(argv) < 2:
        return usage()
    cmd, rest = argv[1], argv[2:]
    if cmd == "add" and len(rest) == 1:
        return cmd_add(rest[0])
    if cmd == "rm" and len(rest) == 1:
        return cmd_rm(rest[0])
    if cmd == "list" and not rest:
        return cmd_list()
    if cmd == "check":
        return cmd_check(as_json="--json" in rest)
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
