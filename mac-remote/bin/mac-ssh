#!/bin/bash
# mac-ssh — SSH from this Muse VM to the user's Mac over Tailscale.
#
# Config resolution (first wins):
#   1. Env vars: MAC_REMOTE_USER, MAC_REMOTE_HOST, MAC_SSH_KEY
#   2. Config file: $MAC_REMOTE_CONFIG, else <state-dir>/config (KEY=VALUE lines)
#
# The state dir (first wins):
#   1. $MAC_REMOTE_STATE_DIR
#   2. the path the installer recorded (<skill>/.state-dir)
#   3. <util>/state when run from a utility checkout (bin/ sits in <util>/)
#   4. the first existing of ~/workspace/muse-utils/state,
#      ~/workspace/mac-remote/state (legacy install locations)
#
# Usage: mac-ssh [ssh args...]    e.g. mac-ssh 'uptime'
set -euo pipefail

if [ -n "${MAC_REMOTE_STATE_DIR:-}" ]; then
  STATE_DIR="$MAC_REMOTE_STATE_DIR"
else
  BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
  UTIL_DIR="$(dirname "$BIN_DIR")"
  if [ -f "$UTIL_DIR/.state-dir" ]; then
    STATE_DIR="$(cat "$UTIL_DIR/.state-dir")"
  elif [ -d "$UTIL_DIR/state" ]; then
    STATE_DIR="$UTIL_DIR/state"
  else
    for d in "$HOME/workspace/muse-utils/state" "$HOME/workspace/mac-remote/state"; do
      if [ -d "$d" ]; then STATE_DIR="$d"; break; fi
    done
    STATE_DIR="${STATE_DIR:-$HOME/workspace/muse-utils/state}"
  fi
fi

CONFIG_FILE="${MAC_REMOTE_CONFIG:-$STATE_DIR/config}"
if [ -f "$CONFIG_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$CONFIG_FILE"
  set +a
fi

MAC_REMOTE_USER="${MAC_REMOTE_USER:?MAC_REMOTE_USER is not set (the macOS username). See references/setup.md}"
MAC_REMOTE_HOST="${MAC_REMOTE_HOST:?MAC_REMOTE_HOST is not set (the Mac Tailscale IP). See references/setup.md}"
MAC_SSH_KEY="${MAC_SSH_KEY:-$STATE_DIR/id_ed25519}"
[ -f "$MAC_SSH_KEY" ] || { echo "SSH key not found: $MAC_SSH_KEY — see references/setup.md" >&2; exit 1; }

# The tailnet is reachable only through the runtime tunnel proxy: same host as
# $HTTPS_PROXY, but port 3130 selects Tailscale. TCP with CONNECT only.
proxy_noport="${HTTPS_PROXY:?HTTPS_PROXY is not set — this script runs on a Muse VM.}"; proxy_noport="${proxy_noport%:*}"
proxy_noscheme="${proxy_noport#*://}"
proxy_host="${proxy_noscheme#*@}"
proxy_userpass="${proxy_noscheme%@*}"

exec ssh -n -o BatchMode=yes -o ConnectTimeout=30 -o StrictHostKeyChecking=accept-new \
  -i "$MAC_SSH_KEY" \
  -o ProxyCommand="socat STDIO PROXY:${proxy_host}:%h:%p,proxyport=3130,proxyauth=${proxy_userpass}" \
  "$MAC_REMOTE_USER@$MAC_REMOTE_HOST" "$@"
